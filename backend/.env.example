# Homer playable architecture backend
# Generate independent random values for both secrets; never commit real values.
HOMER_PUBLIC_BRIDGE_URL=http://host.docker.internal:3012
HOMER_PUBLIC_BRIDGE_SECRET=
HOMER_PLAY_IP_SECRET=
HOMER_PLAY_DAILY_CAP_USD=2.0
HOMER_PLAY_FLASH_MODEL=gemini-2.5-flash-lite

# Shared existing backend dependencies used by Homer play.
GEMINI_API_KEY=
REDIS_URL=redis://localhost:6379/0
TRUST_FORWARDED_IP=false
